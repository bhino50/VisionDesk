<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>VisionDesk</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>VisionDesk finds the Mac you pair with, displays its screens, and sends the pointer and keyboard input you choose.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_visiondesk._tcp</string>
    </array>
    <key>NSUserActivityTypes</key>
    <array>
        <string>org.visiondesk.open-display</string>
    </array>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
        <key>UIApplicationPreferredDefaultSceneSessionRole</key>
        <string>UIWindowSceneSessionRoleApplication</string>
    </dict>
</dict>
</plist>
